NODE_ENV=development

PORT=5000

DATABASE_URL="postgresql://reachinbox:reachinbox_password@localhost:5432/reachinbox_db?schema=public"

REDIS_HOST="localhost"
REDIS_PORT=6379
# REDIS_URL="rediss://default:password@your-endpoint.upstash.io:6379"

WORKER_CONCURRENCY=10
INTER_EMAIL_DELAY_MS=2000
DEFAULT_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=200
PROCESSING_TIMEOUT_MS=120000

# Elasticsearch Full-Text Search
ELASTICSEARCH_URL="http://localhost:9200"

# Slack OAuth & Webhook Rate-Limit Alerts
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_REDIRECT_URI="http://localhost:5000/api/slack/callback"

JWT_SECRET="reachinbox_super_secret_jwt_key_2026"
SESSION_SECRET="reachinbox_super_secret_session_key_2026"

GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
GOOGLE_CALLBACK_URL="http://localhost:5000/api/auth/google/callback"

FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:5000"

SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
